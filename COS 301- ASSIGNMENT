#include <cmath> 
// <cmath> provides functions like sqrt (square root) and pow (power).

// We'll define a function that performs a complex calculation.
double calculateHypotenuse(double a, double b) {
    
    // We can calculate the square of a and b using std::pow:
    // a^2 + b^2
    double sum_of_squares = std::pow(a, 2) + std::pow(b, 2);
    
    // We then find the square root of the sum using std::sqrt:
    // sqrt(a^2 + b^2)
    double hypotenuse = std::sqrt(sum_of_squares);
    
    return hypotenuse;
}

int main() {
    
    // Define the lengths of the two legs of a right triangle
    const double side_a = 3.0;
    const double side_b = 4.0;
    
    // Call the function to calculate the hypotenuse
    // (This result would typically be printed, but we omit I/O here)
    double result = calculateHypotenuse(side_a, side_b);
    
    // The result is 5.0 (since 3^2 + 4^2 = 9 + 16 = 25, and sqrt(25) = 5)

    // The program successfully calculates the value, but the user won't see it
    // because we deliberately avoided I/O libraries!
    
    return 0; 
}
